{
  "trailingSlash": true,
  "redirects": [
    { "source": "/noticia-:slug.html", "destination": "/noticia/:slug/", "permanent": true },
    { "source": "/secao-:slug.html", "destination": "/secao/:slug/", "permanent": true },
    { "source": "/sobre.html", "destination": "/sobre/", "permanent": true },
    { "source": "/politica-editorial.html", "destination": "/politica-editorial/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/noticia/:slug", "destination": "/noticia-:slug.html" },
    { "source": "/secao/:slug", "destination": "/secao-:slug.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/politica-editorial", "destination": "/politica-editorial.html" },
    { "source": "/favicon.ico", "destination": "/favicon.png" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
